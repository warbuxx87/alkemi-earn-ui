{
    "name": "@project-alkemi/alkemi-earn-ui",
    "version": "1.38.1",
    "homepage": "https://earn.alkemi.network",
    "repository": {
        "type": "git",
        "url": "git@bitbucket.org:project-alkemi/alkemi-earn-ui.git"
    },
    "private": true,
    "files": [
        "dist"
    ],
    "scripts": {
        "generate-build-version": "node generate-build-version",
        "start": "react-scripts start",
        "local": "env-cmd -f .env.local npm run start",
        "dev": "env-cmd -f .env.dev npm run start",
        "start:rinkeby": "env-cmd -f .env.rinkeby npm run start",
        "build": "react-scripts build",
        "distribute:prep": "rm -rf dist && mkdir dist && babel src -d dist --copy-files",
        "analyze": "source-map-explorer 'build/static/js/*.js'",
        "prettier": "prettier --write './**/*'",
        "test": "react-scripts test --env=jsdom",
        "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
        "eject": "react-scripts eject"
    },
    "dependencies": {
        "@castrated-drizzle/store": "^1.6.5",
        "@date-io/moment": "^2.10.8",
        "@devexpress/dx-react-chart": "^2.7.5",
        "@devexpress/dx-react-chart-material-ui": "^2.7.5",
        "@devexpress/dx-react-core": "^2.7.5",
        "@gnosis.pm/safe-apps-web3-react": "0.6.8",
        "@ledgerhq/iframe-provider": "0.4.2",
        "@material-ui/core": "^4.11.3",
        "@material-ui/icons": "^4.11.2",
        "@material-ui/lab": "^4.0.0-alpha.57",
        "@material-ui/pickers": "^3.3.10",
        "@sentry/react": "^6.2.5",
        "@sentry/tracing": "^6.2.5",
        "@walletconnect/web3-provider": "^1.7.0",
        "@web3-react/core": "^6.1.9",
        "@web3-react/injected-connector": "^6.0.7",
        "@web3-react/types": "^6.0.7",
        "@web3-react/walletconnect-connector": "^6.2.8",
        "@web3-react/walletlink-connector": "^6.2.13",
        "apexcharts": "^3.26.0",
        "big.js": "^6.0.3",
        "chart.js": "^3.1.0",
        "clsx": "^1.1.1",
        "connected-react-router": "^6.9.1",
        "copy-to-clipboard": "^3.3.1",
        "env-cmd": "^10.1.0",
        "eslint-plugin-flowtype": "^5.7.0",
        "ethers": "^5.7.1",
        "formik": "^2.2.6",
        "formik-material-ui": "^3.0.1",
        "jose": "^4.10.3",
        "jwt-encode": "^1.0.1",
        "lodash": "^4.17.21",
        "moment": "^2.29.1",
        "node-sass": "^5.0.0",
        "react": "^17.0.2",
        "react-apexcharts": "^1.3.9",
        "react-chartjs-2": "^2.11.1",
        "react-dom": "^17.0.2",
        "react-error-boundary": "^3.1.4",
        "react-feather": "^2.0.9",
        "react-intl": "^5.15.8",
        "react-perfect-scrollbar": "^1.5.8",
        "react-redux": "^7.2.3",
        "react-router-dom": "^5.2.0",
        "react-scripts": "^4.0.3",
        "react-toastify": "^7.0.3",
        "redux": "^4.0.5",
        "redux-thunk": "^2.3.0",
        "reselect": "^4.0.0",
        "styled-components": "^5.2.3",
        "web3": "^1.6.1",
        "web3-ledgerhq-frame-connector": "1.0.1",
        "yup": "^0.32.9"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,json,css}": [
            "prettier --write",
            "git add"
        ]
    },
    "jest": {
        "snapshotSerializers": [
            "enzyme-to-json/serializer"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx}",
            "!**/src/index.js",
            "!**/src/registerServiceWorker.js"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "eslintConfig": {
        "extends": "react-app",
        "settings": {
            "import/resolver": {
                "node": {
                    "paths": [
                        "src"
                    ]
                }
            }
        }
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ],
    "devDependencies": {
        "@babel/cli": "^7.13.14",
        "@babel/core": "^7.13.15",
        "@babel/plugin-proposal-class-properties": "^7.13.0",
        "@babel/plugin-transform-modules-commonjs": "^7.13.8",
        "@babel/plugin-transform-runtime": "^7.13.15",
        "@babel/preset-env": "^7.13.15",
        "@babel/preset-react": "^7.13.13",
        "@commitlint/cli": "^12.1.1",
        "@commitlint/config-conventional": "^12.1.1",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/npm": "^7.1.1",
        "@semantic-release/release-notes-generator": "^9.0.2",
        "@testing-library/react": "^11.2.6",
        "babel-loader": "^8.2.2",
        "babel-plugin-module-resolver": "^4.1.0",
        "conventional-changelog-cli": "^2.1.1",
        "css-loader": "^5.2.1",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.6",
        "enzyme-to-json": "^3.6.2",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^4.5.1",
        "husky": "^4.3.7",
        "lint-staged": "^10.5.4",
        "prettier": "^2.2.1",
        "redux-test-utils": "^1.0.2",
        "sass-loader": "^11.0.1",
        "semantic-release": "^17.4.2",
        "source-map-explorer": "^2.5.2",
        "style-loader": "^2.0.0",
        "url-loader": "^4.1.1",
        "webpack": "^4.45.0",
        "webpack-cli": "^3.3.11",
        "webpack-dev-server": "^3.11.2"
    },
    "babel": {
        "presets": [
            "@babel/preset-react"
        ],
        "plugins": [
            [
                "module-resolver",
                {
                    "root": [
                        "./src"
                    ],
                    "extensions": [
                        ".js",
                        ".jsx",
                        ".css",
                        ".scss",
                        ".json",
                        ".svg",
                        ".png",
                        ".jpeg",
                        ".jpg"
                    ]
                }
            ]
        ]
    },
    "release": {
        "branches": [
            "development"
        ],
        "repositoryUrl": "git@bitbucket.org:project-alkemi/alkemi-earn-ui.git",
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/npm",
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "CHANGELOG.md"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci] \n\n${nextRelease.notes}"
                }
            ]
        ]
    }
}

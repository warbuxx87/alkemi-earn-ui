        "react-intl": "^3.4.0",
        "react-redux": "^7.2.0",
        "react-responsive": "^7.0.0",
        "react-router-dom": "^5.1.2",
        "react-scripts": "^3.4.1",
        "redux": "^4.0.5",
        "redux-saga": "^1.1.3",

{
    "name": "@project-alkemi/alkemi-earn-ui",
    "version": "1.9.1",
    "homepage": "https://earn.alkemi.network",
    "repository": {
        "type": "git",
        "url": "git@bitbucket.org:project-alkemi/alkemi-earn-ui.git"
    },
    "private": true,
    "files": [
        "dist"
    ],
    "dependencies": {
        "@devexpress/dx-react-chart": "^2.6.3",
        "@devexpress/dx-react-chart-material-ui": "^2.6.3",
        "@devexpress/dx-react-core": "^2.6.3",
        "@drizzle/react-plugin": "^1.5.3",
        "@drizzle/store": "^1.5.3",
        "@material-ui/core": "^4.11.0",
        "@material-ui/icons": "^4.9.1",
        "@material-ui/lab": "^4.0.0-alpha.56",
        "@sentry/react": "^5.23.0",
        "@sentry/tracing": "^5.23.0",
        "apexcharts": "^3.20.1",
        "big.js": "^6.0.2",
        "bnc-onboard": "^1.13.0",
        "chart.js": "^2.9.3",
        "clsx": "^1.1.1",
        "connected-react-router": "^6.8.0",
        "env-cmd": "^10.1.0",
        "eslint-plugin-flowtype": "^5.1.3",
        "fortmatic": "^2.2.1",
        "lodash": "^4.17.15",
        "node-sass": "^4.14.1",
        "react": "^16.13.1",
        "react-apexcharts": "^1.3.7",
        "react-chartjs-2": "^2.10.0",
        "react-dom": "npm:@hot-loader/react-dom@^16.13.0",
        "react-feather": "^2.0.8",
        "react-hot-loader": "^4.12.21",
        "react-intl": "^4.6.3",
        "react-perfect-scrollbar": "^1.5.8",
        "react-redux": "^7.2.0",
        "react-router-dom": "^5.2.0",
        "react-scripts": "^3.4.1",
        "react-toastify": "^6.0.8",
        "redux": "^4.0.5",
        "redux-thunk": "^2.3.0",
        "reselect": "^4.0.0",
        "styled-components": "^5.2.0",
        "web3": "^1.2.7",
        "yup": "^0.31.0"
    },
    "scripts": {
        "generate-build-version": "node generate-build-version",
        "start": "react-scripts start",
        "build": "react-scripts build",
        "build:staging": "env-cmd -f .env.staging npm run build",
        "distribute:prep": "rm -rf dist && mkdir dist && babel src -d dist --copy-files",
        "analyze": "source-map-explorer 'build/static/js/*.js'",
        "prettier": "prettier --write './**/*'",
        "test": "react-scripts test --env=jsdom",
        "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
        "eject": "react-scripts eject"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,json,css}": [
            "prettier --write",
            "git add"
        ]
    },
    "jest": {
        "snapshotSerializers": [
            "enzyme-to-json/serializer"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx}",
            "!**/src/index.js",
            "!**/src/registerServiceWorker.js"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "eslintConfig": {
        "extends": "react-app",
        "settings": {
            "import/resolver": {
                "node": {
                    "paths": [
                        "src"
                    ]
                }
            }
        }
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ],
    "devDependencies": {
        "@babel/cli": "^7.11.6",
        "@babel/core": "^7.11.6",
        "@babel/plugin-proposal-class-properties": "^7.10.1",
        "@babel/plugin-transform-modules-commonjs": "^7.10.4",
        "@babel/plugin-transform-runtime": "^7.11.5",
        "@babel/preset-env": "^7.11.5",
        "@babel/preset-react": "^7.10.1",
        "@commitlint/cli": "^8.3.5",
        "@commitlint/config-conventional": "^11.0.0",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/npm": "^7.0.6",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@testing-library/react": "^10.4.7",
        "babel-loader": "^8.1.0",
        "babel-plugin-module-resolver": "^4.0.0",
        "conventional-changelog-cli": "^2.0.31",
        "css-loader": "^3.5.3",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.4",
        "enzyme-to-json": "^3.5.0",
        "file-loader": "^6.1.0",
        "html-webpack-plugin": "^4.4.1",
        "husky": "^4.3.0",
        "lint-staged": "^10.3.0",
        "prettier": "^2.0.5",
        "redux-test-utils": "^1.0.0",
        "sass-loader": "^8.0.2",
        "semantic-release": "^17.2.2",
        "source-map-explorer": "^2.4.2",
        "style-loader": "^1.2.1",
        "url-loader": "^4.1.0",
        "webpack": "^4.43.0",
        "webpack-cli": "^3.3.11",
        "webpack-dev-server": "^3.11.0"
    },
    "babel": {
        "presets": [
            "@babel/preset-react"
        ],
        "plugins": [
            [
                "module-resolver",
                {
                    "root": [
                        "./src"
                    ],
                    "extensions": [
                        ".js",
                        ".jsx",
                        ".css",
                        ".scss",
                        ".json",
                        ".svg",
                        ".png",
                        ".jpeg",
                        ".jpg"
                    ]
                }
            ]
        ]
    },
    "release": {
        "branches": [
            "development"
        ],
        "repositoryUrl": "git@bitbucket.org:project-alkemi/alkemi-earn-ui.git",
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            "@semantic-release/npm",
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "CHANGELOG.md"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci] \n\n${nextRelease.notes}"
                }
            ]
        ]
    }
}
